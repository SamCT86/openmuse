{"version": 2, "width": 88, "height": 24, "timestamp": 1789630888, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "OpenMuse exact-action approval demo"}
[0.0, "o", "$ python examples/e2e_demo.py\r\n"]
[1.5, "o", "1  Agent runs task: read inbox and draft launch plan\r\n"]
[3.8, "o", "2  PAUSED before sensitive action\r\n"]
[4.8, "o", "   tool: write_file\r\n"]
[5.8, "o", "   path: plan.md\r\n"]
[6.8, "o", "   content: # Plan / / - Prepare the Show HN launch\r\n"]
[8.0, "o", "   action sha256: 2605623ccee3ad58...\r\n"]
[9.2, "o", "   Approve this exact action? [y/N] "]
[13.2, "i", "y"]
[13.2, "o", "y\r\n"]
[14.6, "o", "3  Host issues a one-time token for this action digest\r\n"]
[16.6, "o", "4  Action runs; task completes\r\n"]
[18.5, "o", "5  Audit proof saved: .openmuse-demo/audit.jsonl\r\n"]
[20.4, "o", "   Verify it: python examples/verify_audit.py\r\n"]
[22.8, "o", "\r\n$ python examples/verify_audit.py\r\n"]
[25.0, "o", "VERIFIED: 3 records form an intact hash chain\r\n"]
[27.2, "o", "VERIFIED: approved action == executed action (2605623ccee3ad58...)\r\n"]
[29.7, "o", "\r\n$ cat .openmuse-demo/plan.md\r\n"]
[31.2, "o", "# Plan\r\n\r\n- Prepare the Show HN launch\r\n"]
